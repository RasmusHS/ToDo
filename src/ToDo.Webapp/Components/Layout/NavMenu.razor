@using ToDo.Webapp.Dto.Queries.ToDoList
@using ToDo.Webapp.Services
@implements IDisposable
@inject IToDoListService ToDoListService
@inject NavigationManager Navigation
@inject INavMenuService NavService

@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ToDo.Webapp</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @foreach (var todoList in queryDto)
        {
            string idString = $"list/{todoList.Id}";
            <div class="nav-item px-3">
                <NavLink class="nav-link" href=@idString> 
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true" ></span> @todoList.ListTitle 
                </NavLink>
            </div>
        }
        
    </nav>
</div>

@code
{

    private List<QueryToDoListSummaryDto> queryDto = new();

    protected override void OnInitialized()
    {
        NavService.OnUpdate += UpdateMenuAsync;
    }
    protected override async Task OnInitializedAsync()
    {
        await UpdateListTable();
    }
    private async Task UpdateListTable()
    {
        queryDto = await ToDoListService.GetAllToDoListsAsync();
        
        StateHasChanged();
    }

    private void GoToToDoList(Guid listId)
    {
        Navigation.NavigateTo($"/list/{listId}");
    }
    private async Task UpdateMenuAsync()
    {
        await InvokeAsync(() => StateHasChanged());
        await UpdateListTable();
    }

    public void Dispose()
    {
        NavService.OnUpdate -= UpdateMenuAsync;
    }

    
}