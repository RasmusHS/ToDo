@page "/"
@using System.Diagnostics.CodeAnalysis
@inject IToDoListService ToDoListService
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>To-Do Lists</h1>

<form method="post" @onsubmit="Submit" @formname="new-todo-list-creator">
    <AntiforgeryToken />
    <div>
        <label>
            Identifier: 
            <InputText @bind-Value="newToDoListTitle" />
        </label>
    </div>
    <div>
        <button type="submit">Submit</button>
    </div>
</form>

@if (false)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Done</th>
                <th>ToDo </th>
                <th>Created On</th>
                <th>Modified On</th>
            </tr>
        </thead>
        <tbody>
            @* @foreach (var todoList in todoLists)
            {
                <tr>
                    <td><input type="checkbox" @bind-value="@IsChecked" @bind-value:after="CheckboxChanged"></td>
                    <td>@todoList.ListTitle</td>
                    <td>@todoList.CreatedOn</td>
                    <td>@todoList.ModifiedOn</td>
                </tr>
            } *@
        </tbody>
    </table>
}

@code {
    private CreateToDoListDto createDto = new();
    public required string newToDoListTitle {get; set;}

    protected override void OnInitialized()
    {
        createDto = new CreateToDoListDto();
        //base.OnInitialized();
    }

    private async void AddToDoList(string _newListTitle)
    {
        var newToDoList = new CreateToDoListDto
        {
            ListTitle = _newListTitle
        };

        await ToDoListService.PostToDoListAsync(newToDoList);
    }

    [Parameter]
    public bool IsChecked { get; set; } = true;
    private void CheckboxChanged()
    {
        Console.WriteLine($"Checkbox changed {IsChecked}");
    }

    public async void Submit()
    {
        Console.WriteLine($"Attempting to create TODO List {newToDoListTitle}");
        if (!string.IsNullOrWhiteSpace(newToDoListTitle))
            {
                AddToDoList(newToDoListTitle);
                Console.WriteLine($"Succesfully created TODO List {newToDoListTitle}");
            }
    }
}
