@page "/"
@using System.Diagnostics.CodeAnalysis
@inject IToDoListService ToDoListService
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1 class="todoTitle">Overview of To-Do lists</h1>

<form method="post" @onsubmit="Submit" @formname="new-todo-list-creator">
    <AntiforgeryToken />
    <div>
        <label class="todoCreateLabel">
            Create new Todo-list:
            <br>
            <InputText class="todoField" id="todoListTitleField" placeholder="Insert title" @bind-Value="newToDoListTitle" />
            <InputText class="todoField" id="todoListDescriptionField" placeholder="Insert description (not required)" 
                @bind-value="newTodoListDescription" />
            <button class="todoButton" id="todoListSubmitButton" type="submit">Submit</button>
        </label>
    </div>
</form>

@if (queryDto.Count <= 0)
{
    <p><em>Add a list to begin</em></p>
}
else
{
    <table class="table" id="todoListTable">
        <thead>
            <tr>
                <th>List Title</th>
                <th>Items </th>
                <th>Created On</th>
                <th>Modified On</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var todoList in queryDto)
            {
                <tr>
                    <td>@todoList.ListTitle</td>
                    <td>0</td>
                    <td>@todoList.CreatedOn</td>
                    <td>@todoList.ModifiedOn</td>
                    <td> <button class="todoButton" id="todoListDeleteButton" @onclick="removeTodoList">Delete</button></td> 
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private CreateToDoListDto createDto = new();
    public required string newToDoListTitle {get; set;}
    public string newTodoListDescription {get; set;}

    private List<QueryToDoListDto> queryDto = new();

    protected override void OnInitialized()
    {
        createDto = new CreateToDoListDto();
        //base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await updateListTable();
    }

    private async void AddToDoList(string _newListTitle)
    {
        @* TODO - update method to also include "newTodoListDescription" when there is one *@
        var newToDoList = new CreateToDoListDto
        {
            ListTitle = _newListTitle
        };
        await ToDoListService.PostToDoListAsync(newToDoList);
        Console.WriteLine($"Succesfully ADDED TODO List {_newListTitle}");
        await updateListTable();
    }
    public async void Submit()
    {
        Console.WriteLine($"Attempting to create TODO List {newToDoListTitle}");
        if (!string.IsNullOrWhiteSpace(newToDoListTitle))
        {
            AddToDoList(newToDoListTitle);
            Console.WriteLine($"Succesfully CREATED TODO List {newToDoListTitle}");
        }
    }

    private async Task updateListTable()
    {
        queryDto = await ToDoListService.GetAllToDoListsAsync();
        StateHasChanged();
    }

    private async void removeTodoList()
    {
        @* TODO - Implement this method *@
        Console.WriteLine("Not implemented yet");
    }
}