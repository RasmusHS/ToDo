@page "/"
@using System.Diagnostics.CodeAnalysis
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>To-Do List</h1>

<button @onclick="OpenToDoPopup">Add new To-Do</button>

<Popup @ref="popupRef" />

@if (todoItems == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Done</th>
                <th>ToDo </th>
                <th>Created On</th>
                <th>Modified On</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var todoItem in todoItems)
            {
                <tr>
                    <td><input type="checkbox" @bind-value="@IsChecked" @bind-value:after="CheckboxChanged"></td>
                    <td>@todoItem.Text</td>
                    <td>@todoItem.CreatedOn</td>
                    <td>@todoItem.ModifiedOn</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ToDoItem> todoItems = [];
    private Popup popupRef;
    private void OpenToDoPopup()
    {
        popupRef.Show();
    }
    private void CreateToDo(string nameText)
    {
        todoItems.Add( new ToDoItem(nameText));
        Console.WriteLine($"Created TODO Item {nameText}");
    }
    private class ToDoItem
    {
        public required string Text {get; set;}
        public required DateTime CreatedOn {get; set;}
        public required DateTime ModifiedOn {get; set;}
        
        [SetsRequiredMembers]
        public ToDoItem(string descriptiveText)
        {
            Text = descriptiveText;
            CreatedOn = DateTime.Now;
            ModifiedOn = DateTime.Now;
        }
    }

    [Parameter]
    public bool IsChecked { get; set; } = true;
    private void CheckboxChanged()
    {
        Console.WriteLine($"Checkbox changed {IsChecked}");
    }
}