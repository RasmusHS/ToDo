@page "/"
@using ToDo.Webapp.Dto
@using ToDo.Webapp.Dto.Queries.ToDoList
@using ToDo.Webapp.Services
@using ToDo.Webapp.Components.Shared
@inject IToDoListService ToDoListService
@inject INavMenuService NavService
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1 class="todoTitle">Overview of To-Do lists</h1>

<form method="post" @onsubmit="Submit" @formname="new-todo-list-creator">
    <AntiforgeryToken />
    <div>
        <label class="todoCreateLabel">
            Create new Todo-list:
            <br>
            <InputText class="todoField" id="todoListTitleField" placeholder="Insert title" @bind-Value="newToDoListTitle" />
            <InputText class="todoField" id="todoListDescriptionField" placeholder="Insert description (not required)" 
                @bind-value="newTodoListDescription" />
            <button class="todoButton" id="todoListSubmitButton" type="submit">Submit</button>
        </label>
    </div>
</form>

@if (queryDto.Count <= 0)
{
    <p><em>Add a list to begin</em></p>
}
else
{
    <table class="table table-striped table-hover" id="todoListTable">
        <thead>
            <tr>
                <th>List Title</th>
                <th>Items </th>
                <th>Created On</th>
                <th>Modified On</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var todoList in queryDto)
            {
                string idString = $"list/{todoList.Id}";
                <tr>
                    <td><a href=@idString class="d-block text-decoration-none text-dark"> @todoList.ListTitle </a></td>
                    <td><a href=@idString class="d-block text-decoration-none text-dark"> @todoList.ItemCount </a></td>
                    <td><a href=@idString class="d-block text-decoration-none text-dark"> @todoList.CreatedOn </a></td>
                    <td><a href=@idString class="d-block text-decoration-none text-dark"> @todoList.ModifiedOn </a></td>
                    <td> <button class="todoButton" id="todoListEditButton" @onclick="() => ShowEditListPrompt(todoList)">Edit</button></td>  
                    <td> <button class="todoButton" id="todoListDeleteButton" @onclick="() => ShowDeleteListPrompt(todoList)">Delete</button></td>
                </tr>
            }
        </tbody>
    </table>
}

<ConfirmationModal IsVisible="showDeleteModal"
                   Title="Confirm Deletion"
                   Message="@deleteMessage"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete" />

<EditListModal     IsVisible="showEditListModal"
                   Title="@editListTitle"
                   OnConfirm="ConfirmEdit"
                   OnCancel="CancelEdit" />

@code {
    [Parameter] public EventCallback<List<QueryToDoListSummaryDto>> ListsChanged { get; set; }
    private CreateToDoListDto createDto = new();
    public required string newToDoListTitle {get; set;}

    public required string newTodoListDescription {get; set;}

    private List<QueryToDoListSummaryDto> queryDto = new();
    private List<ErrorResponseDto> errors = new();

    protected override void OnInitialized()
    {
        createDto = new CreateToDoListDto();
        //base.OnInitialized();
    }

    // Modal vars
    private bool showDeleteModal = false;
    private string deleteMessage = "";
    private QueryToDoListSummaryDto? selectedList;

    private bool showEditListModal = false;
    private string editListTitle = "";
    private string editListDescription = "";
    

    protected override async Task OnInitializedAsync()
    {
        await UpdateListTable();
    }

    private async void AddToDoList(string _newListTitle, string _newDescription)
    {
        var newToDoList = new CreateToDoListDto
        {
            ListTitle = _newListTitle,
            ListDescription = _newDescription
        };
        await ToDoListService.PostToDoListAsync(newToDoList);
        Console.WriteLine($"Succesfully ADDED TODO List {_newListTitle}");
        await UpdateListTable();

        await UpdateNavMenuAsync();
        Console.WriteLine("UPDATED NAVMENU");

    }

    public async void Submit()
    {
        Console.WriteLine($"Attempting to create TODO List {newToDoListTitle}");
        if (!string.IsNullOrWhiteSpace(newToDoListTitle))
        {
            AddToDoList(newToDoListTitle, newTodoListDescription);
            Console.WriteLine($"Succesfully CREATED TODO List {newToDoListTitle}");

        }
    }

    

    private async Task UpdateListTable()
    {
        var result = await ToDoListService.GetAllToDoListsAsync();
        
        if (result.IsT0)
        {
            queryDto = result.AsT0;
            errors.Clear();
        }
        else
        {
            errors.AddRange(result.AsT1);
        }

        StateHasChanged();
    }

    private Task UpdateNavMenuAsync()
    {
        return NavService.UpdateNavMenuAsync();
    }

    private void ShowDeleteListPrompt(QueryToDoListSummaryDto listDto)
    {
        selectedList = listDto;
        deleteMessage = $"Are you sure you want to delete the list '{selectedList.ListTitle}'?";
        showDeleteModal = true;
    }

    private void ShowEditListPrompt(QueryToDoListSummaryDto listDto)
    {
        selectedList = listDto;
        editListTitle = $"Edit '{selectedList.ListTitle}'?";
        showEditListModal = true;
    }

    private void CancelDelete()
    {
        selectedList = null;
        showDeleteModal = false;
    }

    private async void ConfirmDelete()
    {
        RemoveTodoList();
    }

    private void CancelEdit()
    {
        showEditListModal = false;
    }

    private async Task ConfirmEdit((string, string) values)
    {
        editListTitle = values.Item1;
        editListDescription = values.Item2;
        await EditToDoList(editListTitle, editListDescription);
    }

    private async Task EditToDoList(string _newListTitle, string _newDescription)
    {
        var updateToDoList = new UpdateToDoListDto
        {
            ListTitle = _newListTitle,
            ListDescription = _newDescription
        };
        await ToDoListService.PutToDoListAsync(updateToDoList);
        Console.WriteLine($"Succesfully Edited TODO List {_newListTitle}");
    }

    private async void RemoveTodoList()
    {
        @* TODO - Implement this method *@
        
        Console.WriteLine("Deleting lists not implemented yet");
    }
}