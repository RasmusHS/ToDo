@page "/list/{listId:guid}"
@using ToDo.Webapp.Dto
@using ToDo.Webapp.Components.Shared
@using ToDo.Webapp.Dto.Queries.ToDoItem
@using ToDo.Webapp.Dto.Queries.ToDoList
@using ToDo.Webapp.Services

@inject IToDoItemService ToDoItemService
@inject IToDoListService ToDoListService
@rendermode InteractiveServer

<PageTitle>@queryDto.ListTitle</PageTitle>
<h1>@queryDto.ListTitle</h1>
<h5>@queryDto.ListDescription</h5>
<h6>Amount: @queryDto.ToDoItems!.Count</h6>

<form method="post" @onsubmit="Submit" @formname="new-todo-item-creator">
    <AntiforgeryToken />
    <div>
        <label class='todoCreateLabel'>
            Create new Todo:
            <br>
            <InputText class="todoField" id="todoItemField" placeholder="Insert To-Do Title" @bind-Value="newToDoItemText" />
            <button class="todoButton" id="todoItemSubmitButton" type="submit">Submit</button>
        </label>
    </div>
</form>

<table class="table table-striped table-hover" id="todoItemTable">
    <thead>
        <tr>
            <th>To-Do</th>
            <th>Created On</th>
            <th>Modified On</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var todoItem in queryDto.ToDoItems!)
        {
            <tr>
                <td>@todoItem.Text</td>
                <td>@todoItem.CreatedOn</td>
                <td>@todoItem.ModifiedOn</td>
                <td> <button class="todoButton" id="todoItemEditButton" @onclick="() => ShowEditItemPrompt(todoItem)">Edit</button></td> 
                <td> <button class="todoButton" id="todoItemDeleteButton" @onclick="() => RemoveToDoItem(todoItem.Id)">Delete</button></td> 
            </tr>
        }
    </tbody>
</table>

<EditItemModal     IsVisible="showEditItemModal"
                   Title="@editItemText"
                   OnConfirm="ConfirmEdit"
                   OnCancel="CancelEdit" />

@code {
    private CreateToDoItemDto createDto = new();

    private QueryToDoListDto queryDto = new();
    private List<ErrorResponseDto> errors = new();
    
    public required string newToDoItemText {get; set;}

    // Modal vars
    private QueryToDoItemDto? selectedItem;

    private bool showEditItemModal = false;
    private string editItemText = "";

    [Parameter]
    public Guid listId { get; set; }
    protected override async Task OnInitializedAsync()
    {
        //NavigationManager.OnNotFound += HandleNotFound;

        await UpdateItemTable();

        if (queryDto == null)
        {
            //NavigationManager.NotFound();
        }
    }
    private async void AddToDoItem(string text, string? status)
    {
        var newToDoItem = new CreateToDoItemDto
        {
            ToDoListId = listId,
            Text = text
        };
        await ToDoItemService.PostToDoItemAsync(newToDoItem);
        await UpdateItemTable();
    }
    public async void Submit()
    {
        if (!string.IsNullOrWhiteSpace(newToDoItemText))
        {
            AddToDoItem(newToDoItemText, null); // TODO: Null for now until status field has been added
        }
        newToDoItemText = "";
    }
    private void ShowEditItemPrompt(QueryToDoItemDto itemDto)
    {
        selectedItem = itemDto;
        editItemText = $"Edit '{selectedItem.Text}'?";
        showEditItemModal = true;
    }

    private void CancelEdit()
    {
        showEditItemModal = false;
    }

    private async Task ConfirmEdit(string newText)
    {
        editItemText = newText;
        await EditToDoItem(editItemText);
        await UpdateItemTable();
        showEditItemModal = false;
    }

    private async Task UpdateItemTable()
    {
        var result = await ToDoListService.GetToDoListAsync(listId);
        
        if (result.IsT0)
        {
            queryDto = result.AsT0;
            errors.Clear();
        }
        else
        {
            errors.AddRange(result.AsT1);
        }

        StateHasChanged();
    }

    private async void RemoveToDoItem(Guid id)
    {
        await ToDoItemService.DeleteToDoItemAsync(id);
        await UpdateItemTable();
    }

    private async Task EditToDoItem(string text)
    {
        if (selectedItem is not null)
        {
            var updateToDoItem = new UpdateToDoItemDto
            {
                Id = selectedItem.Id,
                Text = text,
            };
            await ToDoItemService.PutToDoItemAsync(updateToDoItem);
        }
    }

}
