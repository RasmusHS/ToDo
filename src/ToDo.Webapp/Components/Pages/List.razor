@page "/list/{listId:guid}"
@using ToDo.Webapp.Components.Shared
@using ToDo.Webapp.Dto.Queries.ToDoItem
@using ToDo.Webapp.Dto.Queries.ToDoList
@using ToDo.Webapp.Services

@inject IToDoItemService ToDoItemService
@inject IToDoListService ToDoListService
@rendermode InteractiveServer

<PageTitle>@queryDto.ListTitle</PageTitle>
<h1>@queryDto.ListTitle</h1>
<h5>@queryDto.ListDescription</h5>
<h6>Amount: @queryDto.ToDoItems!.Count</h6>


<form method="post" @onsubmit="Submit" @formname="new-todo-item-creator">
    <AntiforgeryToken />
    <div>
        <label class='todoCreateLabel'>
            Create new Todo:
            <br>
            <InputText class="todoField" id="todoItemField" placeholder="Insert To-Do Title" @bind-Value="newToDoItemText" />
            <button class="todoButton" id="todoItemSubmitButton" type="submit">Submit</button>
        </label>
    </div>
</form>

<table class="table table-striped table-hover" id="todoItemTable">
    <thead>
        <tr>
            <th>To-Do</th>
            <th>Created On</th>
            <th>Modified On</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var todoItem in queryDto.ToDoItems!)
        {
            <tr>
                <td>@todoItem.Text</td>
                <td>@todoItem.CreatedOn</td>
                <td>@todoItem.ModifiedOn</td>
                <td> <button class="todoButton" id="todoItemDeleteButton" @onclick="() => ShowDeleteItemPrompt(todoItem)">Delete</button></td> 
            </tr>
        }
    </tbody>
</table>

<ConfirmationModal IsVisible="showDeleteModal"
                   Title="Confirm Deletion"
                   Message="@deleteMessage"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete" />

@code {
    private CreateToDoItemDto createDto = new();

    private QueryToDoListDto queryDto = new();
    
    public required string newToDoItemText {get; set;}
    private bool showDeleteModal = false;
    private string deleteMessage = "";
    private QueryToDoItemDto? selectedItem;


    [Parameter]
    public Guid listId { get; set; }
    protected override async Task OnInitializedAsync()
    {
        //NavigationManager.OnNotFound += HandleNotFound;

        await updateItemTable();

        if (queryDto == null)
        {
            //NavigationManager.NotFound();
            Console.WriteLine($"List not found with Id {listId}");
        }
    }
    private async void AddToDoItem(string text, string? status)
    {
        var newToDoItem = new CreateToDoItemDto
        {
            ToDoListId = listId,
            Text = text
        };
        await ToDoItemService.PostToDoItemAsync(newToDoItem);
        Console.WriteLine($"Succesfully ADDED TODO Item {text}");
        await updateItemTable();
    }
    public async void Submit()
    {
        Console.WriteLine($"Attempting to create TODO Item {newToDoItemText}");
        if (!string.IsNullOrWhiteSpace(newToDoItemText))
        {
            AddToDoItem(newToDoItemText, null); // TODO: Null for now until status field has been added
            Console.WriteLine($"Succesfully CREATED TODO Item {newToDoItemText}");
        }
        newToDoItemText = "";
    }

    private async Task updateItemTable()
    {
        queryDto = await ToDoListService.GetToDoListAsync(listId);
        StateHasChanged();
    }
    private void ShowDeleteItemPrompt(QueryToDoItemDto itemDto)
    {
        selectedItem = itemDto;
        deleteMessage = $"Are you sure you want to delete '{selectedItem.Text}'?";
        showDeleteModal = true;
    }
    private void CancelDelete()
    {
        selectedItem = null;
        showDeleteModal = false;
    }

    private async void ConfirmDelete()
    {
        RemoveTodoItem();
    }
    private async void RemoveTodoItem()
    {
        @* TODO - Implement this method *@
        Console.WriteLine("Deleting todoItems not implemented yet");
    }

}
